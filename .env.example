# Salin file ini menjadi .env lalu isi dengan password Anda sendiri.
DB_PASSWORD=
WEB_PORT=8080

# Hostinger Email: 465 = SSL/TLS, 587 = STARTTLS (wajib terenkripsi).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
# Password mailbox, bukan password login hPanel. Gunakan kutip tunggal bila ada $ atau #.
SMTP_PASSWORD=
SMTP_FROM_NAME=
# Penerima awal untuk akun aplikasi yang belum menyimpan pengaturan Notify.
NOTIFY_RECIPIENTS=
