# Copy this file to .env and provide your own configuration values.
DB_PASSWORD=
WEB_PORT=8080

# Cloudflare Tunnel connector token used by docker-compose.cloudflare.yml.
# Route the public hostname to http://web:80 in the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# Hostinger Email: 465 = SSL/TLS, 587 = STARTTLS (encryption required).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME= 
# Use the mailbox password. Use single quotes for values containing $ or #.
SMTP_PASSWORD=
SMTP_FROM_NAME=
# Default recipients for accounts without saved notification settings.
NOTIFY_RECIPIENTS=
